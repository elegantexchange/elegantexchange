# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=elegantexchange

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=shop@elegantexchange.co
ADMIN_PASSWORD=change-me
ADMIN_NAME=Youseline S.
CORS_ORIGINS=http://localhost:3000

# Frontend URL (OAuth redirect after Square connects + invite email links)
FRONTEND_URL=http://localhost:3000

# Optional SMTP for team invite emails (if unset, invites are logged to the backend console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="The Elegant Exchange <shop@elegantexchange.co>"
# SMTP_TLS=true

# Square — https://developer.squareup.com/apps
# Sandbox: use Sandbox Application ID/Secret, SQUARE_ENVIRONMENT=sandbox
# Production (go-live): switch app to Production in Square dashboard
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=http://localhost:8000/api/square/callback
SQUARE_ENVIRONMENT=sandbox

# Optional: reload demo data on empty DB (leave unset for production)
# SEED_DEMO=true

# AI scan assist (item + tag photos) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_SCAN_MODEL=gpt-4o-mini
